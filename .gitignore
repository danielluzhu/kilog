# The live workout database and everything derived from it.
data/
*.db
*.db-shm
*.db-wal
*.db.bak-*

# ...except the committed backup snapshot, which is deliberate. The log is
# already public on the gh-pages branch, so this exposes nothing new — it is
# here to be restorable, which the exported JSON is not.
!backups/workout.db

# Original spreadsheet export the database was migrated from (scripts/migrate.ts).
*.xlsx

# Favicon source bundle — the generated icons in public/ are what's actually served.
favicon_io_lxj.zip

# Local Claude Code settings (machine-specific paths and permissions).
.claude/settings.local.json

# Generated by `bun run build:static`. Contains the log itself as JSON, so it
# is never committed to this branch — publishing it is a deliberate act.
dist/

node_modules/
.DS_Store
